# Copy to .env (never committed). On the server the deploy writes it from the
# repository's variables (public values) and secrets – same names (see README
# → Deploy).

# Public address, no trailing slash – the admin's live preview and the
# CSRF check use it.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Random secret for the admin login (at least 32 characters):
#   openssl rand -hex 32
PAYLOAD_SECRET=

# Local: the MongoDB from docker-compose.dev.yml (`make up-db`). On the server
# docker-compose.yml sets it itself (mongodb://mongo:27017/ppp).
DATABASE_URL=mongodb://localhost:27020/ppp

# The first admin, created at start as long as there is none – otherwise
# /admin offers “create first user” to whoever comes first. Can go once the
# admin exists. Also what `pnpm seed:demo` logs in with.
PAYLOAD_ADMIN_EMAIL=
PAYLOAD_ADMIN_PASSWORD=

# The server's SSH host alias, for `pnpm payload:sync` (database and uploads
# from production to here).
SYNC_REMOTE=portfolio-server
